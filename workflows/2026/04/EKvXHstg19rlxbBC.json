    {
      "parameters": {
        "content": "## Analyze\nDeterministic score in **Code Composite Score** (transparent weights).\n**OpenAI** returns structured JSON (summary, signals, red flags).",
        "height": 140,
        "width": 400,
        "color": 7
      },
      "id": "700e646d-1132-4590-b713-d29487ee718b",
      "name": "Analyze",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        3040,
        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "// Composite Score Engine — transparent rules (edit to extend indicators)\nconst item = { ...$json };\nconst q = item.quote || {};\nconst dp = Number(q.dp) || 0;\nconst newsArr = Array.isArray(item.news) ? item.news : [];\nconst earn = item.earnings || {};\nconst earnList = Array.isArray(earn.earningsCalendar) ? earn.earningsCalendar : [];\nconst filingsRoot = item.filings;\nlet filingsArr = [];\nif (Array.isArray(filingsRoot)) filingsArr = filingsRoot;\nelse if (filingsRoot && Array.isArray(filingsRoot.data)) filingsArr = filingsRoot.data;\n\nlet momentum = Math.max(-18, Math.min(18, dp * 2.2));\n\nconst posWords = /beat|growth|upgrade|strong|bull|record|expansion|deal|win|launch|innovation|surprise/i;\nconst negWords = /miss|weak|downgrade|lawsuit|probe|investigation|layoff|warning|delay|recall|breach|fraud|sec/i;\nlet pos = 0;\nlet neg = 0;\nfor (const n of newsArr.slice(0, 30)) {\n  const h = `${n.headline || ''} ${n.summary || ''}`;\n  if (posWords.test(h)) pos++;\n  if (negWords.test(h)) neg++;\n}\nconst newsSent = Math.max(-12, Math.min(12, (pos - neg) * 2));\nconst buzz = Math.max(0, Math.min(6, Math.floor(newsArr.length / 3)));\n\nlet earnBoost = 0;\nconst today = new Date();\nfor (const row of earnList) {\n  const d = row.date ? new Date(row.date) : null;\n  if (!d || isNaN(d.getTime())) continue;\n  const days = (d - today) / 86400000;\n  if (days >= 0 && days <= 5) earnBoost = Math.max(earnBoost, 10);\n  else if (days > 5 && days <= 14) earnBoost = Math.max(earnBoost, 5);\n}\n\nconst recentFilings = filingsArr.filter((f) => {\n  const form = String(f.form || '').toUpperCase();\n  return ['8-K', '10-Q', '10-K', '4'].includes(form);\n});\nconst filingJitter = Math.min(8, recentFilings.length * 2);\nconst eightk = recentFilings.filter((f) => String(f.form || '').toUpperCase() === '8-K').length;\nconst riskFlag = eightk >= 2 ? 1 : 0;\n\nlet raw =\n  50 +\n  momentum +\n  newsSent +\n  buzz +\n  earnBoost +\n  filingJitter -\n  riskFlag * 6 +\n  (neg > pos ? -4 : 0);\nconst composite = Math.max(0, Math.min(100, Math.round(raw)));\n\nreturn [\n  {\n    json: {\n      ...item,\n      composite_score: composite,\n      headline_count: newsArr.length,\n      score_breakdown: {\n        momentum,\n        newsSent,\n        buzz,\n        earnBoost,\n        filingJitter,\n        riskFlag,\n        neg_headlines: neg,\n        pos_headlines: pos,\n      },\n    },\n  },\n];\n"
      },
      "id": "a64746f6-38ed-494a-8990-5e0c90633975",
      "name": "Code Composite Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3616,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = { ...$json };\nconst sys =\n  'You are an equity research assistant. Respond with JSON only. Keys: ticker, score (0-100, align with composite_score), sentiment (bullish|neutral|bearish), summary (<=120 words), key_signals (string array), red_flags (string array), alert_recommended (boolean), rationale_short (one sentence). No prose outside JSON.';\nconst user = `composite_score hint: ${item.composite_score}. Explain what changed, why it matters, main risks, whether it deserves watchlist attention.\\nDATA:${JSON.stringify(item)}`;\nitem.openai_body = {\n  model: 'gpt-4o-mini',\n  temperature: 0.25,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: sys },\n    { role: 'user', content: user },\n  ],\n};\nreturn [{ json: item }];\n"
      },
      "id": "40c008ff-97b5-415f-a7ff-8e646a28f3c7",
      "name": "Code Prepare OpenAI Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3840,
        272
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.openai_body) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "5e6210bb-e083-423f-888b-65269c2ed4d3",
      "name": "HTTP OpenAI Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4064,
        272
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const openai = $input.item.json;\nconst base = $('Code Composite Score').item.json;\nlet content = openai.choices?.[0]?.message?.content || '{}';\nlet ai;\ntry {\n  ai = JSON.parse(content);\n} catch (e) {\n  ai = {\n    ticker: base.ticker,\n    score: base.composite_score,\n    sentiment: 'neutral',\n    summary: 'AI parse failed — inspect OpenAI response.',\n    key_signals: [],\n    red_flags: ['ai_parse_error'],\n    alert_recommended: true,\n    rationale_short: content.slice(0, 200),\n  };\n}\nconst thr = Number(base.alert_threshold ?? 70);\nconst scoreHi = Number(base.composite_score) >= thr;\nconst bearNews =\n  String(ai.sentiment || '').toLowerCase() === 'bearish' &&\n  (base.score_breakdown?.neg_headlines || 0) > 2;\nconst filingRisk = Number(base.score_breakdown?.riskFlag || 0) >= 1;\nai.alert_recommended =\n  Boolean(ai.alert_recommended) || scoreHi || bearNews || filingRisk;\nconst record = {\n  ...base,\n  ai,\n  composite_score: Number(ai.score) || base.composite_score,\n  run_timestamp: new Date().toISOString(),\n};\nconst t = record.ticker;\nconst s = record.composite_score;\nconst sent = ai.sentiment;\nrecord.slack_alert_text =\n  `🚨 *Stock Radar — Alert*\\n*${t}* | Score *${s}* | *${sent}*\\n• ${ai.rationale_short || ''}\\n• ${(ai.summary || '').slice(0, 320)}`;\nrecord.email_body = record.slack_alert_text.replace(/\\*/g, '');\nreturn [{ json: record }];\n"
      },
