    {
      "parameters": {
        "jsCode": "const start = (!$execution.startedAt ? new Date(0) : new Date($execution.startedAt));\nconst rows = $input\n  .all()\n  .map((i) => i.json)\n  .filter((r) => r.timestamp && !isNaN(new Date(r.timestamp).getTime()))\n  .filter((r) => new Date(r.timestamp) >= start);\nrows.sort((a, b) => Number(b.composite_score || 0) - Number(a.composite_score || 0));\nconst top = rows.slice(0, 5);\nconst day = start.toISOString().slice(0, 10);\nlet md = `☕ *Stock Radar — Daily Brief*\\n_${day}_ (Top ${top.length})\\n\\n`;\ntop.forEach((r, i) => {\n  md += `${i + 1}. *${r.ticker}* — *${r.composite_score}* (${r.ai_sentiment || 'n/a'})\\n   _${String(r.summary || '').slice(0, 160)}…_\\n\\n`;\n});\nif (!top.length) {\n  md += '_No log rows matched this execution window — widen the Sheet read range or check timestamps._\\n';\n}\nreturn [{ json: { digest_markdown: md, digest_plain: md.replace(/\\*/g, ''), top } }];\n"
      },
