        "jsCode": "const MAX = 49000;\n\nfunction unwrap(x) {\n  return x && typeof x === 'object' && x.json != null ? x.json : x;\n}\n\nfunction shrinkArray(items, mapRow, maxLen) {\n  const rows = items.map(unwrap).map(mapRow);\n  while (rows.length && JSON.stringify(rows).length > maxLen) {\n    rows.pop();\n  }\n  let s = JSON.stringify(rows);\n  if (s.length <= maxLen) return rows;\n  while (rows.length) {\n    const row = rows[rows.length - 1];\n    for (const k of Object.keys(row)) {\n      if (typeof row[k] === 'string' && row[k].length > 80) {\n        row[k] = row[k].slice(0, 60) + '…';\n      }\n    }\n    s = JSON.stringify(rows);\n    if (s.length <= maxLen) return rows;\n    rows.pop();\n  }\n  return [{ _note: 'rows_did_not_fit_under_limit', max: maxLen }];\n}\n\nfunction shrinkObject(v, maxLen) {\n  if (v == null) return v;\n  let s = JSON.stringify(v);\n  if (s.length <= maxLen) return v;\n  if (typeof v === 'object' && !Array.isArray(v)) {\n    const o = { ...v };\n    for (const k of Object.keys(o)) {\n      if (typeof o[k] === 'string' && o[k].length > 6000) {\n        o[k] = o[k].slice(0, 6000) + '…';\n      }\n    }\n    s = JSON.stringify(o);\n    if (s.length <= maxLen) return o;\n    return {\n      _truncated: true,\n      ticker: o.ticker,\n      sentiment: o.sentiment,\n      summary: typeof o.summary === 'string' ? o.summary.slice(0, 12000) : undefined,\n      rationale_short:\n        typeof o.rationale_short === 'string' ? o.rationale_short.slice(0, 2000) : undefined,\n    };\n  }\n  return { _truncated: true, type: typeof v, preview: s.slice(0, maxLen - 40) + '…' };\n}\n\nconst j = { ...$input.item.json };\n\nj.news = shrinkArray(\n  Array.isArray(j.news) ? j.news : [],\n  (a) => ({\n    headline: String(a?.headline ?? '').slice(0, 320),\n    source: a?.source,\n    datetime: a?.datetime,\n    url: String(a?.url ?? '').slice(0, 400),\n  }),\n  MAX,\n);\n\nj.filings = shrinkArray(\n  Array.isArray(j.filings) ? j.filings : j.filings ? [j.filings] : [],\n  (f) => ({\n    form: f?.form,\n    filedDate: f?.filedDate,\n    filingUrl: String(f?.filingUrl ?? '').slice(0, 400),\n  }),\n  MAX,\n);\n\nj.earnings = shrinkObject(j.earnings, MAX);\nj.score_breakdown = shrinkObject(j.score_breakdown, MAX);\nj.ai = shrinkObject(j.ai, MAX);\n\nreturn [{ json: j }];\n"
      },
